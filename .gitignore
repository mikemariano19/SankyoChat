# Live workspace data: messages, profiles, password-protected keys, attachments.
# Never commit it. Only the readme that explains the folder is tracked.
data/*
!data/README.txt
data-backup-*/
data-replaced-*/
# Updater work folder (old-version copies, log) and built update packages
_updates/
dist/
# Per-PC backup settings (where this PC saves its hourly backups)
backup/backup-settings.json

# Editor / OS clutter
.vscode/
.idea/
Thumbs.db
desktop.ini
*.crswap
